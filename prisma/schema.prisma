// Disclosure Ledger — Postgres (prefer EU: Neon eu-central-1 / Vercel Postgres fra1)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Paid / free entitlement keyed by contact email (and optional Stripe ids)
model Entitlement {
  id                   String   @id @default(cuid())
  email                String   @unique
  stripeCustomerId     String?  @unique @map("stripe_customer_id")
  stripeSubscriptionId String?  @map("stripe_subscription_id")
  /// none | active | trialing | past_due | canceled | unpaid | incomplete | incomplete_expired | paused
  subscriptionStatus   String   @default("none") @map("subscription_status")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  records              DisclosureRecord[]
  scans                Scan[]

  @@map("entitlements")
}

model DisclosureRecord {
  id                String   @id
  createdAt         DateTime @default(now()) @map("created_at")
  contentHashSha256 String   @map("content_hash_sha256")
  fileName          String   @map("file_name")
  fileSizeBytes     Int      @map("file_size_bytes")
  mimeType          String   @map("mime_type")
  aiDeclaration     String   @map("ai_declaration")
  notes             String   @default("")
  contactEmail      String?  @map("contact_email")
  /// ProvenanceSummary JSON: { found, method, details, signals }
  provenance        Json
  entitlementId     String?  @map("entitlement_id")
  entitlement       Entitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)

  @@index([entitlementId])
  @@index([contactEmail])
  @@index([createdAt])
  @@map("disclosure_records")
}

model PrivacyRequest {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")
  email     String
  /// access | erasure | rectification
  type      String
  note      String?

  @@index([email])
  @@index([createdAt])
  @@map("privacy_requests")
}


/// Public-site hygiene scan (possible disclosure gaps to review — not an audit)
model Scan {
  id            String        @id
  createdAt     DateTime      @default(now()) @map("created_at")
  contactEmail  String        @map("contact_email")
  targetUrl     String        @map("target_url")
  /// completed | failed
  status        String        @default("completed")
  pagesCrawled  Int           @default(0) @map("pages_crawled")
  imagesChecked Int           @default(0) @map("images_checked")
  /// Crawl caps / summary JSON
  summary       Json
  entitlementId String?       @map("entitlement_id")
  entitlement   Entitlement?  @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  findings      ScanFinding[]

  @@index([contactEmail])
  @@index([createdAt])
  @@index([entitlementId])
  @@map("scans")
}

model ScanFinding {
  id       String  @id
  scanId   String  @map("scan_id")
  scan     Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  /// no_nearby_disclosure | no_ledger_link | missing_provenance_hints
  kind     String
  /// review (possible gap)
  severity String  @default("review")
  pageUrl  String? @map("page_url")
  assetUrl String? @map("asset_url")
  message  String
  evidence Json?

  @@index([scanId])
  @@index([kind])
  @@map("scan_findings")
}


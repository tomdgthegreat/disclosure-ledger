# Stripe Checkout (~$29/mo after 3 free records). Optional for local MVP.
# Soft-gate still shows in UI when unset.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Optional publishable key for future client Elements (not required Day-1)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Minimal /ops password view. Leave empty to disable ops API.
OPS_PASSWORD=

# Public site URL — production canonical apex (www redirects to apex)
NEXT_PUBLIC_APP_URL=https://discloseledger.com

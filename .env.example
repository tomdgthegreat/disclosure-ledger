# Public site URL — production canonical apex
NEXT_PUBLIC_APP_URL=https://discloseledger.com

# Postgres (Neon eu-central-1 / Vercel Postgres fra1 — EU preferred).
# When unset, app falls back to local data/db.json (not durable on Vercel).
DATABASE_URL=

# Stripe Checkout — €29/mo EUR subscription after 3 free records per contact email.
# Do NOT invent or commit secrets. Set STRIPE_SECRET_KEY in Vercel / .env.local only.
STRIPE_SECRET_KEY=
# Documented EUR €29/mo Price id (not a secret)
STRIPE_PRICE_ID=price_1UG5ICJA3LJpXY1w7S3MbOid
# Webhook signing secret — endpoint: https://discloseledger.com/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.updated|deleted
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Minimal /ops password view. Leave empty to disable ops API.
OPS_PASSWORD=
